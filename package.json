{
  "name": "bd-stock-api",
  "version": "1.1.0",
  "description": "Website-ready API for current public DSE market feeds",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps dist/src/app.js",
    "start-server": "npm start",
    "dev": "tsc-watch --noClear --onSuccess \"npm start\"",
    "test": "npm run build && node --test tests/*.test.cjs",
    "smoke": "npm run build && node scripts/smoke.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.4",
    "axios-retry": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
