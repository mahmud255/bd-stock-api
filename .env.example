PORT=4000
DSE_BASE_URL=https://www.dse.com.bd
UPSTREAM_TIMEOUT_MS=15000
CACHE_TTL_SECONDS=60
STALE_TTL_SECONDS=300
HISTORY_CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY_HOPS=0
# Optional. When set, /v1/dse routes require X-API-Key.
API_KEY=
# Comma-separated browser origins. Same-origin and server requests work without this.
CORS_ORIGINS=http://localhost:3000
